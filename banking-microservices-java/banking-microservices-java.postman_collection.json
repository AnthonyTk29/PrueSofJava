{
  "info": {
    "name": "Banking Microservices Java",
    "description": "Collection for banking-microservices-java (Spring Boot 3 / Java 21).\n\nServices:\n- customers-service → http://localhost:8081\n- accounts-service  → http://localhost:8082\n\nSeed data:\n- Customers: id 1 (Jose Lema), id 2 (Marianela Montalvo), id 3 (Juan Osorio)\n- Accounts: 478758 (SAVINGS/customerId=1), 225487 (CHECKING/customerId=2), 495878 (SAVINGS/customerId=3), 496825 (SAVINGS/customerId=2), 585545 (CHECKING/customerId=3)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "customers_url",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "accounts_url",
      "value": "http://localhost:8082",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "List all customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customers_url}}/api/customers",
              "host": ["{{customers_url}}"],
              "path": ["api", "customers"]
            },
            "description": "Returns all registered customers.\n\nSuccess response:\n```json\n{\n  \"status\": 200,\n  \"data\": [\n    {\n      \"clientId\": 1,\n      \"name\": \"Jose Lema\",\n      \"gender\": \"Male\",\n      \"age\": 14,\n      \"identification\": \"1234567890\",\n      \"address\": \"Otavalo sn y Quito\",\n      \"phone\": \"098254785\",\n      \"active\": true\n    }\n  ]\n}\n```"
          }
        },
        {
          "name": "Get customer by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customers_url}}/api/customers/1",
              "host": ["{{customers_url}}"],
              "path": ["api", "customers", "1"]
            },
            "description": "Gets a customer by ID. Returns 404 if not found."
          }
        },
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Customer\",\n  \"gender\": \"Male\",\n  \"age\": 30,\n  \"identification\": \"9876543210\",\n  \"address\": \"Av. Amazonas 123\",\n  \"phone\": \"0991234567\",\n  \"password\": \"pass1234\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{customers_url}}/api/customers",
              "host": ["{{customers_url}}"],
              "path": ["api", "customers"]
            },
            "description": "Creates a new customer. Returns 201 with the created customer.\n\nValidations (Jakarta Bean Validation):\n- name: required\n- gender: required\n- age: >= 0\n- identification: required\n- address: required\n- phone: required\n- password: required\n\nValidation error test (empty name):\n```json\n{ \"name\": \"\", ... }\n```"
          }
        },
        {
          "name": "Create customer - Validation error (empty name)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"gender\": \"Male\",\n  \"age\": 25,\n  \"identification\": \"1111222233\",\n  \"address\": \"Street 1\",\n  \"phone\": \"0999999999\",\n  \"password\": \"pass\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{customers_url}}/api/customers",
              "host": ["{{customers_url}}"],
              "path": ["api", "customers"]
            },
            "description": "Should return 400 with validation error:\n```json\n{\n  \"timestamp\": \"...\",\n  \"status\": 400,\n  \"error\": \"Validation error\",\n  \"message\": \"name: Name is required\",\n  \"path\": \"/api/customers\"\n}\n```"
          }
        },
        {
          "name": "Update customer (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jose Lema Updated\",\n  \"gender\": \"Male\",\n  \"age\": 15,\n  \"identification\": \"1234567890\",\n  \"address\": \"New Address 456\",\n  \"phone\": \"098254785\",\n  \"password\": \"new1234\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{customers_url}}/api/customers/1",
              "host": ["{{customers_url}}"],
              "path": ["api", "customers", "1"]
            },
            "description": "Full customer update. Returns 200 with the updated customer."
          }
        },
        {
          "name": "Change customer status (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{customers_url}}/api/customers/1/status?active=false",
              "host": ["{{customers_url}}"],
              "path": ["api", "customers", "1", "status"],
              "query": [
                {
                  "key": "active",
                  "value": "false"
                }
              ]
            },
            "description": "Activates or deactivates a customer. Set active=false to disable, active=true to enable."
          }
        },
        {
          "name": "Delete customer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{customers_url}}/api/customers/1",
              "host": ["{{customers_url}}"],
              "path": ["api", "customers", "1"]
            },
            "description": "Deletes a customer by ID. Returns 200 with the deleted customer data."
          }
        },
        {
          "name": "Get customer - Not found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customers_url}}/api/customers/9999",
              "host": ["{{customers_url}}"],
              "path": ["api", "customers", "9999"]
            },
            "description": "Should return 404:\n```json\n{\n  \"timestamp\": \"...\",\n  \"status\": 404,\n  \"error\": \"Not Found\",\n  \"message\": \"Customer with Id 9999 not found\",\n  \"path\": \"/api/customers/9999\"\n}\n```"
          }
        }
      ]
    },
