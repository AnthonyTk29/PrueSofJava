            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"478758\",\n  \"transactionType\": \"WITHDRAWAL\",\n  \"amount\": -575.00\n}"
            },
            "url": {
              "raw": "{{accounts_url}}/api/transactions",
              "host": ["{{accounts_url}}"],
              "path": ["api", "transactions"]
            },
            "description": "Registers a withdrawal. The amount must be NEGATIVE.\n\nInitial balance of 478758: 2000.00\nExpected resulting balance: 1425.00\n\nResponse:\n```json\n{\n  \"status\": 201,\n  \"data\": {\n    \"transactionType\": \"WITHDRAWAL\",\n    \"amount\": -575.00,\n    \"balance\": 1425.00\n  }\n}\n```"
