            "description": "Obtiene una cuenta por su número de cuenta.\n\nNúmeros seed disponibles: 478758, 225487, 495878, 496825, 585545"
          }
        },
        {
          "name": "Crear cuenta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"999001\",\n  \"tipoCuenta\": \"AHORRO\",\n  \"saldoInicial\": 1500.00,\n  \"clienteId\": 1,\n  \"estado\": true\n}"
            },
            "url": {
              "raw": "{{cuentas_url}}/api/cuentas",
