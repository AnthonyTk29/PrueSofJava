              "host": ["{{accounts_url}}"],
              "path": ["api", "transactions"]
            },
            "description": "Registers a deposit. The amount must be POSITIVE.\n\nInitial balance of 478758: 2000.00\nExpected resulting balance: 2575.00\n\nResponse:\n```json\n{\n  \"status\": 201,\n  \"data\": {\n    \"id\": ...,\n    \"accountNumber\": \"478758\",\n    \"transactionType\": \"DEPOSIT\",\n    \"amount\": 575.00,\n    \"balance\": 2575.00\n  }\n}\n```"
          }
        },
        {
          "name": "Create transaction - Withdrawal",
          "request": {
            "method": "POST",
            "header": [
