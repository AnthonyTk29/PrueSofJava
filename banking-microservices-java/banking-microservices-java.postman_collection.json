        {
          "name": "Obtener movimiento por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{cuentas_url}}/api/movimientos/1",
              "host": ["{{cuentas_url}}"],
              "path": ["api", "movimientos", "1"]
            },
            "description": "Obtiene un movimiento por su ID."
          }
        },
        {
          "name": "Crear movimiento - Depósito",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"tipoMovimiento\": \"DEPOSITO\",\n  \"valor\": 575.00\n}"
            },
            "url": {
              "raw": "{{cuentas_url}}/api/movimientos",
              "host": ["{{cuentas_url}}"],
              "path": ["api", "movimientos"]
            },
            "description": "Registra un depósito. El valor debe ser POSITIVO.\n\nSaldo inicial de 478758: 2000.00\nSaldo resultante esperado: 2575.00\n\nRespuesta:\n```json\n{\n  \"status\": 201,\n  \"data\": {\n    \"id\": ...,\n    \"numeroCuenta\": \"478758\",\n    \"tipoMovimiento\": \"DEPOSITO\",\n    \"valor\": 575.00,\n    \"saldo\": 2575.00\n  }\n}\n```"
          }
        },
        {
          "name": "Crear movimiento - Retiro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"tipoMovimiento\": \"RETIRO\",\n  \"valor\": -575.00\n}"
            },
            "url": {
              "raw": "{{cuentas_url}}/api/movimientos",
              "host": ["{{cuentas_url}}"],
              "path": ["api", "movimientos"]
            },
            "description": "Registra un retiro. El valor debe ser NEGATIVO.\n\nSaldo inicial de 478758: 2000.00\nSaldo resultante esperado: 1425.00\n\nRespuesta:\n```json\n{\n  \"status\": 201,\n  \"data\": {\n    \"tipoMovimiento\": \"RETIRO\",\n    \"valor\": -575.00,\n    \"saldo\": 1425.00\n  }\n}\n```"
          }
        },
        {
          "name": "Crear movimiento - Saldo insuficiente (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"495878\",\n  \"tipoMovimiento\": \"RETIRO\",\n  \"valor\": -500.00\n}"
            },
            "url": {
              "raw": "{{cuentas_url}}/api/movimientos",
              "host": ["{{cuentas_url}}"],
              "path": ["api", "movimientos"]
            },
            "description": "Debe retornar 409 Conflict.\n\nCuenta 495878 tiene saldo 0.00, intentar retirar -500 genera:\n```json\n{\n  \"timestamp\": \"...\",\n  \"status\": 409,\n  \"error\": \"Conflict\",\n  \"message\": \"Saldo no disponible para realizar el retiro\",\n  \"path\": \"/api/movimientos\"\n}\n```"
          }
        },
        {
          "name": "Actualizar movimiento (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"tipoMovimiento\": \"DEPOSITO\",\n  \"valor\": 1000.00\n}"
            },
            "url": {
              "raw": "{{cuentas_url}}/api/movimientos/1",
              "host": ["{{cuentas_url}}"],
              "path": ["api", "movimientos", "1"]
            },
            "description": "Actualiza los datos de un movimiento existente."
          }
        },
        {
          "name": "Eliminar movimiento",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{cuentas_url}}/api/movimientos/1",
              "host": ["{{cuentas_url}}"],
              "path": ["api", "movimientos", "1"]
            },
            "description": "Elimina un movimiento por su ID."
          }
        }
      ]
